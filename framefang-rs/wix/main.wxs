<?xml version="1.0" encoding="utf-8"?>
<!--
  The Frame Fang MSI, in WiX 3 syntax. The release workflow builds it with
  `cargo wix` (cargo-wix 0.3.9, WiX 3.14), which supplies Version and
  CargoTargetBinDir, and publishes the result as Framefang.msi.

  What it installs, per machine:
    %ProgramFiles%\Framefang\framefang.exe and License.rtf
    a Start menu folder "Frame Fang" holding one shortcut
  It adds no autostart entry: that is the app's own Settings switch, and two
  owners of one setting would fight.

  Keep these stable, or upgrades break:
    UpgradeCode    every Frame Fang MSI finds and replaces older ones by it
    the shortcut component's GUID
  ProductCode and PackageCode (Id="*") are new on every build by design.

  FFmpeg is deliberately absent: recording and conversion use the FFmpeg on
  PATH (or the one the app offers to fetch), so the installer stays small
  and carries no GPL binary.
-->
<Wix xmlns="http://schemas.microsoft.com/wix/2006/wi">
  <Product Name="Frame Fang" Manufacturer="winters27" Version="$(var.Version)" Id="*"
           UpgradeCode="EF6E048C-A0C6-4413-ADE6-679F0E461580" Language="1033" Codepage="1252">

    <Package Id="*" Description="Frame Fang: fast screenshots with annotations" Manufacturer="winters27"
             Keywords="Installer" InstallScope="perMachine" InstallerVersion="450" Compressed="yes"
             Languages="1033" SummaryCodepage="1252" />

    <!-- A newer copy refuses to be replaced by an older one. -->
    <MajorUpgrade Schedule="afterInstallInitialize"
                  DowngradeErrorMessage="A newer version of [ProductName] is already installed. Setup will now exit." />

    <!-- Everything travels inside the .msi itself. -->
    <Media Id="1" EmbedCab="yes" Cabinet="media1.cab" DiskPrompt="CD-ROM #1" />
    <Property Id="DiskPrompt" Value="Frame Fang Installation" />

    <Directory Id="TARGETDIR" Name="SourceDir">
      <Directory Id="ProgramFiles64Folder" Name="PFiles">
        <Directory Id="APPLICATIONFOLDER" Name="Framefang">
          <Component Id="binary0" Win64="yes" Guid="*">
            <File Id="exe0" Name="framefang.exe" Source="$(var.CargoTargetBinDir)\framefang.exe" DiskId="1" KeyPath="yes" />
          </Component>
          <Component Id="License" Win64="yes" Guid="*">
            <File Id="LicenseFile" Name="License.rtf" Source="$(sys.SOURCEFILEDIR)License.rtf" DiskId="1" KeyPath="yes" />
          </Component>
        </Directory>
      </Directory>

      <!-- The shortcut lives in a per-user location, so its component needs
           a per-user key path: the registry value. -->
      <Directory Id="ProgramMenuFolder">
        <Directory Id="ApplicationProgramsFolder" Name="Frame Fang">
          <Component Id="StartMenuShortcut" Win64="yes" Guid="D1084C35-9CC7-44EF-9A63-AC5E84CAD8CE">
            <!-- The ID ties Frame Fang's toasts to this shortcut: without it
                 Windows shows them with no name or logo, and drops the modern
                 layout. Must match toast_identity::APP_ID. -->
            <Shortcut Id="FramefangStartMenuShortcut" Name="Frame Fang" Description="Fast screenshots with annotations"
                      Target="[APPLICATIONFOLDER]framefang.exe" WorkingDirectory="APPLICATIONFOLDER" Icon="ProductIcon.ico">
              <ShortcutProperty Key="System.AppUserModel.ID" Value="winters27.FrameFang" />
            </Shortcut>
            <RemoveFolder Id="RemoveApplicationProgramsFolder" On="uninstall" Directory="ApplicationProgramsFolder" />
            <RegistryValue Root="HKCU" Key="Software\Framefang\Framefang" Name="installed" Type="integer" Value="1" KeyPath="yes" />
          </Component>
        </Directory>
      </Directory>
    </Directory>

    <!-- One feature, always installed; only its folder can move. -->
    <Feature Id="Binaries" Title="Application" Description="Installs Frame Fang." Level="1" Display="expand"
             ConfigurableDirectory="APPLICATIONFOLDER" Absent="disallow" AllowAdvertise="no">
      <ComponentRef Id="binary0" />
      <ComponentRef Id="License" />
      <ComponentRef Id="StartMenuShortcut" />
    </Feature>

    <!-- How the app looks and links in Installed apps. There is nothing to
         repair. ARPNOMODIFY is left to WixUI_InstallDir, which already sets
         it; setting it here too fails the link with LGHT0091 (duplicate
         symbol). -->
    <Icon Id="ProductIcon.ico" SourceFile="$(sys.SOURCEFILEDIR)Framefang.ico" />
    <Property Id="ARPPRODUCTICON" Value="ProductIcon.ico" />
    <Property Id="ARPURLINFOABOUT" Value="https://github.com/winters27/framefang" />
    <Property Id="ARPHELPLINK" Value="https://github.com/winters27/framefang" />
    <Property Id="ARPNOREPAIR" Value="1" />

    <!--
      The wizard: license, install folder, confirm. Its last page has a
      "Launch Frame Fang" box, ticked, so both a first install and an in-app
      update end with the app running in the tray instead of nothing.
      WixShellExec with Impersonate="yes" starts it as the person who ran the
      installer, not as the elevated installer.
    -->
    <WixVariable Id="WixUILicenseRtf" Value="$(sys.SOURCEFILEDIR)License.rtf" />
    <Property Id="WIXUI_INSTALLDIR" Value="APPLICATIONFOLDER" />
    <Property Id="WIXUI_EXITDIALOGOPTIONALCHECKBOXTEXT" Value="Launch Frame Fang" />
    <Property Id="WIXUI_EXITDIALOGOPTIONALCHECKBOX" Value="1" />
    <Property Id="WixShellExecTarget" Value="[#exe0]" />
    <CustomAction Id="LaunchFramefang" BinaryKey="WixCA" DllEntry="WixShellExec" Execute="immediate" Impersonate="yes" />
    <UI>
      <UIRef Id="WixUI_InstallDir" />
      <Publish Dialog="ExitDialog" Control="Finish" Event="DoAction" Value="LaunchFramefang">WIXUI_EXITDIALOGOPTIONALCHECKBOX = 1</Publish>
    </UI>
  </Product>
</Wix>
