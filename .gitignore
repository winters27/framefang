# Build output: Cargo's target folders, and the folder the release steps
# stage installers and bundles in (framefang-rs/dist, not the top-level dist/
# that holds the packaging sources).
target/
framefang-rs/dist/
*.msi
*.wixobj
*.wixpdb
*.pdb
*.AppImage
*.dmg

# Machine-local: icon tools and notes (.local), agent and editor state.
.local/
.claude/
.vs/
.vscode/
.idea/
*.swp
.DS_Store
Thumbs.db

# Secrets never belong in the repository.
.env
.env.*
